# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/foodmart
DB_USERNAME=root
DB_PASSWORD=root

# JWT Configuration
JWT_SECRET=ChangeThisSecretKeyChangeThisSecretKey
JWT_EXPIRATION_MS=3600000

# Email Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_API_KEY=rzp_test_YOUR_KEY_ID
RAZORPAY_API_SECRET=your_key_secret
RAZORPAY_MODE=test

# Business Account Settings
BUSINESS_ACCOUNT_NAME=FoodMart
BUSINESS_ACCOUNT_EMAIL=business@foodmart.com
BUSINESS_ACCOUNT_PHONE=+91-XXXXXXXXXX

# Role Registration Invite Codes
APP_SELLER_INVITE_CODE=SELLER_SECRET
APP_ADMIN_INVITE_CODE=ADMIN_SECRET
